# =============================================================================
# Pipeline Webhook Configuration
# =============================================================================

# Comma-separated list of URLs that receive POST requests for pipeline events.
# For Phase 1 (direct to Slack): use your Slack Incoming Webhook URL.
# For Phase 1 (via formatter): use the URL of your slack_notifier service.
PIPELINE_WEBHOOK_URLS=<your-slack-incoming-webhook-url>

# Optional: limit which event types are forwarded to webhooks.
# If empty, ALL events are forwarded.
PIPELINE_WEBHOOK_EVENTS=human_review,escalation,gate_verdict

# Webhook POST timeout in seconds (default: 10).
# PIPELINE_WEBHOOK_TIMEOUT=10

# =============================================================================
# Slack Integration (used by slack_notifier.py)
# =============================================================================

# Slack Incoming Webhook URL for the target channel (e.g. #pipeline-review).
# Get this from: Slack App → Incoming Webhooks → Add New Webhook to Workspace.
SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# Base URL for pipeline report links included in Slack messages.
PIPELINE_REPORT_BASE_URL=https://your-ci.example.com/reports

# =============================================================================
# Phase 2 (Interactive Buttons) — not yet implemented
# =============================================================================

# Slack Bot Token (xoxb-...) — needed for interactive message updates.
# SLACK_BOT_TOKEN=xoxb-...

# Slack channel ID for #pipeline-review.
# SLACK_CHANNEL_ID=C0000000000
